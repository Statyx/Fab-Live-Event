# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Node (presentation/)
node_modules/

# Generated decks — rebuild with `node presentation/build_deck.js` (never commit the binary).
# A PPTX exported from Office may be an OLE/MIP-encrypted container (magic D0CF11E0) carrying a
# rights-management envelope bound to the authoring tenant: un-reviewable, un-greppable, and
# unreadable for anyone who clones the repo.
presentation/*.pptx

# Scratch / logs (terminal capture files used during deploys)
*.log
_*.log
_*.txt
_*.py
_*.json

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Environment-specific — contain tenant / workspace / item IDs. Use the *.example files as templates.
src/config.yaml
src/state.json
.vscode/mcp.json

# (The *.example files ARE committed: src/config.example.yaml, src/state.example.json, .vscode/mcp.example.json)
